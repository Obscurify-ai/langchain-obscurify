{
  "name": "@obscurify/langchain",
  "version": "0.1.1",
  "description": "LangChain.js chat model for Obscurify.ai, a private AI API (OpenAI-compatible)",
  "type": "module",
  "license": "MIT",
  "author": "Obscurify.ai <contact@obscurify.ai>",
  "homepage": "https://obscurify.ai/?utm_source=langchain-obscurify-js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Obscurify-ai/langchain-obscurify.git",
    "directory": "libs/js"
  },
  "bugs": "https://github.com/Obscurify-ai/langchain-obscurify/issues",
  "keywords": [
    "langchain",
    "obscurify",
    "llm",
    "privacy",
    "openai-compatible",
    "chat"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test:int": "vitest run"
  },
  "dependencies": {
    "@langchain/openai": "^1.8.0"
  },
  "peerDependencies": {
    "@langchain/core": "^1.0.0"
  },
  "devDependencies": {
    "@langchain/core": "^1.3.1",
    "langchain": "^1.0.0",
    "tsup": "^9.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0",
    "zod": "^4.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false
}
